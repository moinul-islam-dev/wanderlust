
{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "read": {
      "*": "allow",
      "**/.env*": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    },

    "edit": {
      "**/.env*": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    },

    "grep": {
      "**/.env*": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    },

    "glob": {
      "**/.env*": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    },

    "bash": "ask",
    "external_directory": "ask"
  },

  "compaction": {
    "auto": true
  }
}
